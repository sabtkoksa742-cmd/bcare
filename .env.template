# =============================================
# BCare - Supabase Environment Configuration
# =============================================
# انسخ هذا الملف إلى .env وأضف القيم الصحيحة

# ============== SUPABASE ==============
# احصل على هذه القيم من: https://supabase.com/dashboard/project/_/settings/api

# Project Reference ( найдено в API Settings )
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon/Publishable Key ( العامة - يمكن وضعها في الكود )
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_ANON_KEY

# Secret Key ( خاصة - للنوع server-side فقط )
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY

# ============== DATABASE ==============
# Database Connection String ( من Settings > Database )
DATABASE_URL=postgresql://postgres.YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ============== APP ==============
VITE_API_BASE_URL=/api

# Optional: For local development
# VITE_SUPABASE_URL=http://localhost:54321
# SUPABASE_DB_PASSWORD=postgres